COMPOSE_FILE=compose.dev.yaml
COMPOSE_PROJECT_NAME=laravel-skeleton
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://laravel-skeleton.orb.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single,nightwatch

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10800
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=digital_ocean
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#MAIL_MAILER=ses
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_REDIRECT_URI=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

CASHIER_CURRENCY=EUR
CASHIER_CURRENCY_LOCALE=cs
CASHIER_LOGGER=

SENTRY_LARAVEL_DSN=

REVERB_APP_ID=100001
REVERB_APP_KEY=laravel-skeleton-dev-key
REVERB_APP_SECRET=laravel-skeleton-dev-only
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=reverb.laravel-skeleton.orb.local
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

DO_ACCESS_KEY_ID=
DO_BUCKET=
DO_DEFAULT_REGION=FRA1
DO_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SECRET_ACCESS_KEY=
DO_URL=
DO_USE_PATH_STYLE_ENDPOINT=false

NIGHTWATCH_IGNORE_CACHE_EVENTS=true
NIGHTWATCH_INGEST_URI=nightwatch:2408
NIGHTWATCH_PORT=2408
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1
NIGHTWATCH_TOKEN=

VITE_INERTIA_SSR_PORT=13714
REVERB_SERVER_PORT=8081
