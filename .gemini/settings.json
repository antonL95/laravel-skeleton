{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "php",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn": {
            "command": "docker",
            "args": [
                "compose",
                "run",
                "--rm",
                "--no-deps",
                "-T",
                "bun",
                "bunx",
                "shadcn@4.22.1",
                "mcp"
            ]
        }
    }
}
