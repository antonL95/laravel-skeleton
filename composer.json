{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.384",
        "filament/filament": "^5.6",
        "filament/spatie-laravel-settings-plugin": "^5.6",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/ai": "^0.8.1",
        "laravel/cashier": "^16.5",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^1.28",
        "laravel/octane": "^2.17",
        "laravel/ranger": "0.2.4",
        "laravel/reverb": "^1.10",
        "laravel/socialite": "^5.27",
        "laravel/surveyor": "0.2.3",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "dev-next#4654a7d946a9df8b26dcee11c83c761d6308d9e0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "saloonphp/laravel-plugin": "^4.3",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-enum": "^3.3",
        "spatie/laravel-typescript-transformer": "^3.2",
        "tpetry/laravel-postgresql-enhanced": "^3.7",
        "tpetry/laravel-query-expressions": "^1.6"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "fakerphp/faker": "^1.24.1",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.62",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "larastan/larastan": "^3.10",
        "laravel-lang/lang": "^15.31",
        "laravel-lang/starter-kits": "^1.15",
        "rector/rector": "^2.4",
        "barryvdh/laravel-debugbar": "^4.3",
        "driftingly/rector-laravel": "^2.5",
        "laravel/boost": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php scripts/patch-wayfinder.php"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan lang:update",
            "@php artisan boost:update"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "refactor": "rector",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse",
        "test:arch": "pest tests/Unit/ArchitecturalTest.php",
        "test:type-cov": "pest --type-coverage --min=100",
        "test:unit-cov": "php ./vendor/bin/pest --parallel --coverage",
        "test:unit": "php ./vendor/bin/pest --parallel",
        "test:lint": [
            "pint --test",
            "bun run format:check",
            "bun run lint:check",
            "bun run typecheck",
            "@test:refactor"
        ],
        "lint": [
            "pint --parallel",
            "bun run lint",
            "bun run format",
            "@refactor"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:arch",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
